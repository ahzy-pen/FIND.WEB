@page
@model IndexModel
@{
    ViewData["Title"] = "OSAS FIND — Campus Lost & Found";
    ViewData["Description"] = "OSAS FIND (Found Item & Notification Desk) is the campus lost-and-found system for the Colegio de Montalban community. Report lost belongings, discover found items, and follow a guided recovery process through the FIND mobile application.";
}

